# SageInvest Environment Variables
# Copy this file to .env and fill in your values

# Database Configuration
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/sageinvest

# KIS API Encryption Key
# 64-character hex string for AES-256-GCM encryption
# IMPORTANT: This key is required for storing account numbers securely
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# After changing this key, previously encrypted data will NOT be decryptable!
# Keep this key secret and never commit it to version control.
KIS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Optional: Enable database query logging for debugging
# Set to 'true' to see all SQL queries in the console
DB_LOG_QUERIES=false
